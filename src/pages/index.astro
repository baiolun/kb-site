---
import { withBase } from "../lib/base";
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { Icon } from "astro-icon/components";
import { domainColor } from "../lib/domains";
import { noteHref } from "../lib/noteHref";
import questions from "../data/questions.json";
import stats from "../data/stats.json";
import progress from "../data/progress.json";

const notes = await getCollection("vault", (e) => e.data.collection === "notes");

// ── 知识主题（01-知识笔记 的领域）与内容集合（存储目录）分层 ──
const TOPIC_DOMAINS = [
  "GPU与图形技术", "金融基础", "Web开发", "装机与硬件", "芯片半导体",
  "网络原理", "接口协议", "开发工具链", "光学工程", "软件与驱动",
];
const byDomain = new Map<string, typeof notes>();
for (const n of notes) {
  const list = byDomain.get(n.data.domain) ?? [];
  list.push(n);
  byDomain.set(n.data.domain, list);
}
const topics = TOPIC_DOMAINS.map((d) => ({ domain: d, count: (byDomain.get(d) ?? []).length })).filter((t) => t.count > 0);
const otherDomains = [...byDomain.keys()].filter((d) => !TOPIC_DOMAINS.includes(d));
const collections = otherDomains.map((d) => ({
  domain: d,
  count: (byDomain.get(d) ?? []).length,
  href: d === "07-学习路径" ? withBase("/learn/") : ["考研", "02-科普脚本", "03-公众号输出", "06-对话沉淀", "项目解析", "00-Inbox", "99-Dashboard"].includes(d) ? withBase("/archive/") : withBase(`/domains/${encodeURIComponent(d)}/`),
}));

// ── 接着上次（progress 的 currentState/lastSession，标注记录日期，不冒充实时）──
const cs = progress.currentState ?? {};
const last = cs.lastSession;

// ── 待追问带来源与锚点；按问题日期倒序 ──
const titleToId = new Map(notes.map((n) => [n.data.title, n.id]));
const openQ = [...questions.filter((q) => q.status === "open")]
  .sort((a, b) => b.id.localeCompare(a.id))
  .slice(0, 3)
  .map((q) => {
    const nid = q.note ? titleToId.get(q.note.replace(/^\[\[|\]\]$/g, "")) : undefined;
    return { ...q, noteHref: nid ? noteHref(nid) : undefined };
  });
const openCount = questions.filter((q) => q.status === "open").length;
const updated = (stats.generatedAt ?? "").slice(0, 10);

// ── 最近新增（按创建时间，放右栏）──
const recent = notes
  .filter((n) => n.data.created)
  .sort((a, b) => (b.data.created ?? "").localeCompare(a.data.created ?? ""))
  .slice(0, 5);

const quickLinks = [
  { href: withBase("/graph/"), icon: "lucide:network", label: "知识星图", hint: `${stats.notes} 节点` },
  { href: withBase("/questions/"), icon: "lucide:circle-help", label: "好奇心地图", hint: `${openCount} open` },
  { href: withBase("/learn/"), icon: "lucide:compass", label: "学习路径", hint: "接着上次" },
  { href: withBase("/archive/"), icon: "lucide:book-open", label: "归档", hint: "全部集合" },
];
---

<BaseLayout title="首页" current="home">
  <div class="home-shell">
    {/* ── 左栏：导航 ── */}
    <aside class="home-side">
      <div class="side-card">
        <h3 class="side-title"><Icon name="lucide:zap" /> 快速入口</h3>
        <ul class="side-links">
          {quickLinks.map((l) => (
            <li><a href={l.href}><Icon name={l.icon} /><span class="sl-label">{l.label}</span><span class="sl-hint">{l.hint}</span></a></li>
          ))}
        </ul>
      </div>
      <div class="side-card">
        <h3 class="side-title"><Icon name="lucide:book-open" /> 内容集合</h3>
        <ul class="side-links">
          {collections.map((c) => (
            <li><a href={c.href}><span class="sl-label">{c.domain}</span><span class="sl-hint">{c.count}</span></a></li>
          ))}
        </ul>
      </div>
    </aside>

    {/* ── 主区 ── */}
    <div class="home-main">
      <h1 class="home-title">接着探索</h1>
      <p class="home-sub">
        {stats.notes} 篇笔记 · {stats.edges} 条连接 · {openCount} 个待追问
        <span class="dot-sep">·</span> 数据更新于 {updated}
      </p>

      <div class="home-grid">
        {/* ① 接着上次 */}
        <section class="card-primary" aria-labelledby="resume-h">
          <h2 id="resume-h" class="sec-title"><Icon name="lucide:map-pin" /> 接着上次</h2>
          {(cs.topic || cs.phase) ? (
            <>
              <div class="resume-topic">{cs.phase}{cs.topic ? ` → ${cs.topic}` : ""}{cs.subTopic ? ` → ${cs.subTopic}` : ""}</div>
              {cs.activeProject && <div class="resume-meta">进行中项目：{cs.activeProject}</div>}
              {last && (
                <div class="resume-last">
                  <span class="mono">{last.date}</span>（{last.durationMinutes} 分钟）：{last.summary}
                </div>
              )}
              <div class="resume-actions">
                <a class="btn-accent" href={withBase("/learn/")}>打开学习路径 →</a>
                {last && <span class="hint">记录于 {last.date}，非实时阅读位置</span>}
              </div>
            </>
          ) : (
            <>
              <div class="resume-topic">还没有学习记录</div>
              <div class="resume-actions">
                <a class="btn-accent" href={withBase("/learn/")}>从学习路径开始 →</a>
                <span class="hint">或在下方选一个主题</span>
              </div>
            </>
          )}
        </section>

        {/* ② 还想弄懂 */}
        <section class="card-side" aria-labelledby="ask-h">
          <h2 id="ask-h" class="sec-title"><Icon name="lucide:circle-help" /> 还想弄懂 <a class="more" href={withBase("/questions/")}>全部 {openCount} 条 →</a></h2>
          {openQ.length > 0 ? (
            <ul class="q-lines">
              {openQ.map((q) => (
                <li>
                  <a class="q-text" href={withBase(`/questions/#${q.id}`)}>{q.question}</a>
                  <div class="q-src">
                    <span class="mono">{q.id}</span>
                    {q.noteHref ? <>来自 <a href={q.noteHref}>{q.note}</a></> : q.note ? <span>来自 {q.note}</span> : null}
                  </div>
                </li>
              ))}
            </ul>
          ) : (
            <p class="empty">暂时没有待追问的问题。有好奇的就去问，问题日志会替你记着。</p>
          )}
        </section>
      </div>

      {/* ③ 功夫值 */}
      <section class="home-sec" id="kungfu-panel" aria-labelledby="kungfu-h">
        <h2 id="kungfu-h" class="sec-title"><Icon name="lucide:timer" /> 最近 7 天的功夫 <small>本机活动估计 · 闲置自动暂停 · 不含其他设备</small></h2>
        <div id="kungfu-bars" class="kungfu-bars"></div>
        <div id="kungfu-empty" class="empty" style="display:none">这个浏览器还没有学习记录。随便打开一篇笔记，顶栏计时会自动开始累计。</div>
      </section>

      {/* ④ 按主题找 */}
      <section class="home-sec" aria-labelledby="topics-h">
        <h2 id="topics-h" class="sec-title"><Icon name="lucide:map" /> 按主题找</h2>
        <ul class="domain-lines">
          {topics.map((t) => (
            <li>
              <a href={withBase(`/domains/${encodeURIComponent(t.domain)}/`)}>
                <span class="domain-dot" style={`--domain-c:${domainColor(t.domain)}`}></span>
                <span class="d-name">{t.domain}</span>
                <span class="d-count">{t.count} 篇</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    {/* ── 右栏：动态 ── */}
    <aside class="home-side">
      <div class="side-card">
        <h3 class="side-title"><Icon name="lucide:sparkles" /> 最近新增</h3>
        <ul class="side-recent">
          {recent.map((n) => (
            <li>
              <a href={noteHref(n.id)}>{n.data.title}</a>
              <small>{n.data.created}</small>
            </li>
          ))}
        </ul>
      </div>
      <div class="side-card">
        <h3 class="side-title"><Icon name="lucide:database" /> 全库</h3>
        <div class="side-stats">
          <div><strong>{stats.notes}</strong><small>笔记</small></div>
          <div><strong>{stats.edges}</strong><small>连接</small></div>
          <div><strong>{openCount}</strong><small>待追问</small></div>
        </div>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  // 功夫值面板：astro:page-load 在首次加载与每次站内返回后触发，面板始终重新渲染
  function renderKungfu() {
    const panel = document.getElementById("kungfu-panel");
    const bars = document.getElementById("kungfu-bars");
    const empty = document.getElementById("kungfu-empty");
    if (!panel || !bars || !empty) return;
    const days: { label: string; secs: number }[] = [];
    let storageOk = true;
    for (let i = 6; i >= 0; i--) {
      const d = new Date(Date.now() - i * 86400_000);
      const key = `kungfu-${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
      let secs = 0;
      try { secs = parseInt(localStorage.getItem(key) ?? "0", 10) || 0; } catch { storageOk = false; }
      days.push({ label: `${d.getMonth() + 1}/${d.getDate()}`, secs });
    }
    const max = Math.max(...days.map((d) => d.secs), 60);
    const has = days.some((d) => d.secs > 0);
    panel.style.display = "";
    bars.style.display = has ? "" : "none"; // 空态不渲染 7 个孤点（视觉像故障）
    bars.innerHTML = days
      .map((d) => {
        const h = Math.max((d.secs / max) * 64, 3);
        const txt = d.secs >= 3600 ? `${(d.secs / 3600).toFixed(1)}h` : `${Math.round(d.secs / 60)}m`;
        return `<div style="flex:1;text-align:center">
          <div>${d.secs > 0 ? txt : "·"}</div>
          <div style="height:${h}px;background:var(--accent);border-radius:3px 3px 0 0;margin:2px 0;opacity:${d.secs > 0 ? 0.85 : 0.25}"></div>
          <div>${d.label}</div>
        </div>`;
      })
      .join("");
    empty.style.display = has ? "none" : "";
    empty.innerHTML = storageOk
      ? `今天还没积累功夫。挑一篇笔记开始读，顶栏会自动计时。 <a href="${(import.meta as any).env.BASE_URL.replace(/\/$/, "")}/archive/">去归档逛逛 →</a>`
      : "浏览器本地存储不可用，时长仅本次会话有效（不影响阅读）。";
  }
  renderKungfu();
  document.addEventListener("astro:page-load", renderKungfu);
</script>
