---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { noteHref } from "../lib/noteHref";
import { Icon } from "astro-icon/components";
import progress from "../data/progress.json";

// 学习状态页（2026-09-25）：问题日志退役后，本页承接原「知识面」右栏的复习排程展示。
// 原则不变（2026-09-02 决策）：复习轻量激活、不主动推送——这里只展示状态，出题在对话里说「考我」。
// 到不到期由 progress.json 的 reviewSchedule 唯一决定，页面只读。

const reviews: any[] = Object.values(progress.reviewSchedule ?? {});
const today = new Date().toISOString().slice(0, 10);
const isDue = (r: any) => (r.dueDate ?? "9999") <= today;
const sorted = [...reviews].sort((a, b) => (a.dueDate ?? "").localeCompare(b.dueDate ?? ""));
const due = sorted.filter(isDue);
const upcoming = sorted.filter((r) => !isDue(r)).slice(0, 8);
const weaknesses: any[] = progress.weaknesses ?? [];

const toHref = (p?: string) => (p ? noteHref(p.replace(/\.md$/, "")) : undefined);
const stageLabel = (r: any) => `第 ${r.stage ?? 1} 轮 · 间隔 ${r.intervalDays ?? 1} 天`;
---

<BaseLayout title="学习状态" current="learn">
  <div class="learn-shell">
    <h1 class="home-title">学习状态</h1>
    <p class="home-sub">
      {reviews.length} 个知识点在复习排程里 · {due.length} 个到期
      <span class="dot-sep">·</span> 只做展示不推送；想被考，在对话里说「考我」
    </p>

    <div class="home-grid">
      <section class="card-primary" aria-labelledby="due-h">
        <h2 id="due-h" class="sec-title"><Icon name="lucide:alarm-clock" /> 到期复习{due.length > 0 ? `（${due.length}）` : ""}</h2>
        {due.length > 0 ? (
          <ul class="q-lines">
            {due.map((r) => (
              <li>
                <a class="q-text" href={toHref(r.notePath) ?? withBase("/archive/")}>{r.question}</a>
                <div class="q-src">
                  <span class="mono">{r.dueDate}</span> · {r.topic}
                  <span>· {stageLabel(r)}</span>
                </div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">没有到期的知识点。读完新内容会自动进排程（1/3/7/14/30 天）。</p>
        )}
      </section>

      <section class="card-side" aria-labelledby="up-h">
        <h2 id="up-h" class="sec-title"><Icon name="lucide:calendar-clock" /> 接下来几天</h2>
        {upcoming.length > 0 ? (
          <ul class="q-lines">
            {upcoming.map((r) => (
              <li>
                <a class="q-text" href={toHref(r.notePath) ?? withBase("/archive/")}>{r.question}</a>
                <div class="q-src"><span class="mono">{r.dueDate}</span> · {r.topic}</div>
              </li>
            ))}
          </ul>
        ) : (
          <p class="empty">排程是空的。</p>
        )}
      </section>
    </div>

    <section class="home-sec" aria-labelledby="weak-h">
      <h2 id="weak-h" class="sec-title"><Icon name="lucide:shield-alert" /> 薄弱点 <small>答错回 1 天档时记录</small></h2>
      {weaknesses.length > 0 ? (
        <ul class="domain-lines">
          {weaknesses.map((w) => (
            <li>
              <span class="d-name">{w.topic}{w.subTopics?.length ? `（${w.subTopics.join("、")}）` : ""}</span>
              <span class="d-count">{w.note}</span>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">还没有记录。答错不批评，回炉重排而已。</p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  .learn-shell { max-width: 68rem; margin: 0 auto; padding: 2.2rem 1.4rem 4rem; }
</style>
