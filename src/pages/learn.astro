---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
// 学习路径页已并入「知识面」（提问驱动取代固定路线）；本页保留路由防旧链接失效。
const target = withBase("/questions/");
---

<BaseLayout title="学习路径已并入知识面">
  <div style="min-height:60vh;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.8rem;text-align:center;padding:48px 24px">
    <h1 style="font-size:1.3rem;margin:0">固定路径退休了</h1>
    <p style="color:var(--ink-2);margin:0">知识不是排出来的，是问出来的。你的知识面在这里：</p>
    <a class="btn-accent" href={target} style="margin-top:0.6rem">去看知识面 →</a>
    <meta http-equiv="refresh" content="4;url={target}" />
  </div>
</BaseLayout>
