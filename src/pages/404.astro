---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/base";
import { Icon } from "astro-icon/components";
---

<BaseLayout title="页面不存在">
  <div class="notfound">
    <Icon name="lucide:compass" class="nf-icon" />
    <h1>这一页还没种出来</h1>
    <p>地址可能错了，或者这颗种子还没有发芽。</p>
    <div class="nf-actions">
      <a class="btn-accent" href={withBase("/")}>回首页</a>
      <a class="btn-ghost" href={withBase("/graph/")}>去星图找找</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    min-height: 60vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    padding: 48px 24px;
  }
  .nf-icon { width: 56px; height: 56px; color: var(--accent); opacity: 0.9; }
  .notfound h1 { font-size: 1.6rem; margin: 0; }
  .notfound p { color: var(--ink-2); margin: 0; }
  .nf-actions { display: flex; gap: 12px; margin-top: 16px; }
</style>
