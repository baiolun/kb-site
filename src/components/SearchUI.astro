---
import { Icon } from "astro-icon/components";
// 站内全文搜索（Pagefind）：构建后索引 dist/，本组件只负责 UI 与键盘交互。
// 设计走 kb-site-design tokens；signature = `/` 键呼出 + 领域色点结果行。
---

<button id="search-open" class="search-btn" type="button" aria-label="搜索（快捷键 /）" title="搜索（快捷键 /）">
  <Icon name="lucide:search" />
  <span class="search-kbd">/</span>
</button>

<div id="search-overlay" class="search-overlay" hidden>
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="站内搜索">
    <div class="search-input-row">
      <Icon name="lucide:search" class="search-glyph" />
      <input id="search-input" type="search" placeholder="搜索笔记…" autocomplete="off" spellcheck="false" />
      <button id="search-close" class="search-close" type="button" aria-label="关闭搜索"><Icon name="lucide:x" /></button>
    </div>
    <div id="search-results" class="search-results" aria-live="polite">
      <div class="search-empty">输入关键词，检索全库 132 篇笔记</div>
    </div>
    <div class="search-hints">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span><span><kbd>Enter</kbd> 打开</span><span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>

<style is:global>
  /* 动态 innerHTML 注入的结果元素无 astro scope 属性，样式必须 global（类名 search-/hit- 前缀防污染） */
  .search-btn {
    position: relative; display: inline-flex; align-items: center; gap: 6px;
    background: none; border: 1px solid var(--line); border-radius: 8px;
    color: var(--ink-2); padding: 5px 8px; cursor: pointer;
    transition: border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .search-btn:hover { color: var(--accent); border-color: var(--accent); }
  .search-btn:active { transform: scale(0.96); }
  .search-btn svg { width: 15px; height: 15px; }
  .search-kbd {
    font-family: var(--font-mono); font-size: 10px; line-height: 1;
    border: 1px solid var(--line); border-radius: 4px; padding: 2px 5px; opacity: 0.7;
  }
  .search-overlay[hidden] { display: none; }
  .search-overlay {
    position: fixed; inset: 0; z-index: 90;
    background: color-mix(in srgb, var(--bg) 55%, transparent);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    display: flex; align-items: flex-start; justify-content: center;
    padding: 12vh 16px 16px;
    animation: overlay-in 160ms var(--ease-out);
  }
  @keyframes overlay-in { from { opacity: 0; } }
  .search-panel {
    width: min(560px, 100%); max-height: 68vh; display: flex; flex-direction: column;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 24px 64px color-mix(in srgb, #000 35%, transparent);
    overflow: hidden;
    animation: panel-in 200ms var(--ease-out);
  }
  @keyframes panel-in { from { opacity: 0; transform: translateY(8px) scale(0.99); } }
  .search-input-row { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--line); }
  .search-glyph { width: 16px; height: 16px; color: var(--ink-2); flex: none; }
  #search-input {
    flex: 1; border: none; outline: none; background: none;
    color: var(--ink); font-family: var(--font-body); font-size: 1.05rem;
  }
  #search-input::placeholder { color: var(--ink-2); opacity: 0.6; }
  #search-input::-webkit-search-cancel-button { display: none; }
  .search-close { background: none; border: none; color: var(--ink-2); cursor: pointer; padding: 4px; border-radius: 6px; display: flex; }
  .search-close:hover { color: var(--ink); background: color-mix(in srgb, var(--ink) 8%, transparent); }
  .search-close svg { width: 16px; height: 16px; }
  .search-results { overflow-y: auto; overscroll-behavior: contain; padding: 8px; }
  .search-empty, .search-status { padding: 28px 16px; text-align: center; color: var(--ink-2); font-size: 0.92rem; }
  .search-hit {
    display: block; padding: 10px 12px; border-radius: 10px;
    text-decoration: none; color: inherit;
    transition: background var(--dur-fast) var(--ease-out);
  }
  .search-hit:hover, .search-hit.active { background: color-mix(in srgb, var(--accent) 9%, transparent); }
  .hit-head { display: flex; align-items: center; gap: 8px; margin-bottom: 2px; }
  .hit-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; background: var(--ink-2); }
  .hit-title { font-family: var(--font-heading); font-weight: 600; font-size: 0.95rem; color: var(--ink); }
  .hit-crumb { font-size: 0.78rem; color: var(--ink-2); margin-left: auto; flex: none; }
  .hit-excerpt { font-size: 0.86rem; color: var(--ink-2); line-height: 1.55; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .hit-excerpt mark { background: color-mix(in srgb, var(--accent) 22%, transparent); color: var(--ink); border-radius: 3px; padding: 0 2px; }
  .search-hints {
    display: flex; gap: 14px; padding: 8px 16px; border-top: 1px solid var(--line);
    color: var(--ink-2); font-size: 0.78rem;
  }
  .search-hints kbd {
    font-family: var(--font-mono); font-size: 10px; border: 1px solid var(--line);
    border-radius: 4px; padding: 1px 5px; margin-right: 2px; background: var(--bg);
  }
  @media (max-width: 640px) {
    .search-overlay { padding-top: 8vh; }
    .search-hints { display: none; }
    .search-kbd { display: none; }
  }
</style>

<script>
  const overlay = document.getElementById("search-overlay")!;
  const input = document.getElementById("search-input") as HTMLInputElement;
  const results = document.getElementById("search-results")!;
  const openBtn = document.getElementById("search-open")!;

  type Page = { data: { url?: string; meta?: Record<string, string>; filters?: Record<string, string[]> }; excerpt: string };
  let pagefind: { search: (q: string) => Promise<{ results: { data: () => Promise<Page> }[] }> } | null = null;
  let active = -1;
  let hits: { url: string }[] = [];

  const BASE = (import.meta as any).env.BASE_URL.replace(/\/$/, "");

  // Vite 会给动态 import 包 preload helper 导致运行时失败；用 Function 绕过打包转换
  const dynamicImport = new Function("u", "return import(u)") as (u: string) => Promise<any>;
  async function loadPagefind() {
    if (pagefind) return pagefind;
    try {
      pagefind = await dynamicImport(`${BASE}/pagefind/pagefind.js`);
    } catch { pagefind = null; }
    return pagefind;
  }

  const DOMAIN_COLORS: Record<string, string> = {
    "GPU与图形技术": "#c0392b", "金融基础": "#2980b9", "Web开发": "#27ae60",
    "装机与硬件": "#e67e22", "芯片半导体": "#8e44ad", "网络原理": "#16a085",
    "接口协议": "#b7950b", "开发工具链": "#5d6d7e", "光学工程": "#d4ac0d", "软件与驱动": "#7d6608",
  };

  function setActive(i: number) {
    const items = results.querySelectorAll<HTMLElement>(".search-hit");
    if (!items.length) return;
    active = Math.max(0, Math.min(i, items.length - 1));
    items.forEach((el, j) => el.classList.toggle("active", j === active));
    items[active].scrollIntoView({ block: "nearest" });
  }

  function renderEmpty(text: string) {
    results.innerHTML = `<div class="search-empty">${text}</div>`;
    hits = []; active = -1;
  }

  let debounce: number | undefined;
  input.addEventListener("input", () => {
    clearTimeout(debounce);
    debounce = window.setTimeout(run, 140);
  });

  async function run() {
    const q = input.value.trim();
    if (!q) return renderEmpty("输入关键词，检索全库笔记");
    const pf = await loadPagefind();
    if (!pf) return renderEmpty("搜索索引不可用");
    const res = await pf.search(q);
    if (!res.results.length) return renderEmpty(`没有找到「${q}」相关的内容`);
    const top = await Promise.all(res.results.slice(0, 8).map((r) => r.data()));
    hits = top.map((d) => ({ url: d.url ?? "#" }));
    active = -1;
    results.innerHTML = top.map((d, i) => {
      const title = d.meta?.title ?? "未命名";
      const domain = d.filters?.domain?.[0] ?? "";
      const dot = DOMAIN_COLORS[domain] ?? "var(--ink-2)";
      const crumb = d.meta?.crumb ?? "";
      return `<a class="search-hit" href="${hits[i].url}" data-i="${i}">
        <div class="hit-head">
          <span class="hit-dot" style="background:${dot}"></span>
          <span class="hit-title">${title}</span>
          ${crumb ? `<span class="hit-crumb">${crumb}</span>` : ""}
        </div>
        <div class="hit-excerpt">${d.excerpt}</div>
      </a>`;
    }).join("");
    results.querySelectorAll<HTMLAnchorElement>(".search-hit").forEach((a) => {
      a.addEventListener("mousemove", () => setActive(Number(a.dataset.i)));
    });
  }

  function open() {
    overlay.hidden = false;
    document.documentElement.style.overflow = "hidden";
    input.value = "";
    renderEmpty("输入关键词，检索全库笔记");
    setTimeout(() => input.focus(), 30);
    loadPagefind(); // 预加载索引
  }
  function close() {
    overlay.hidden = true;
    document.documentElement.style.overflow = "";
  }

  openBtn.addEventListener("click", open);
  document.getElementById("search-close")!.addEventListener("click", close);
  overlay.addEventListener("mousedown", (e) => { if (e.target === overlay) close(); });

  document.addEventListener("keydown", (e) => {
    const tag = (e.target as HTMLElement)?.tagName;
    const typing = tag === "INPUT" || tag === "TEXTAREA";
    if (!overlay.hidden) {
      if (e.key === "Escape") { e.preventDefault(); close(); }
      else if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter") {
        const items = results.querySelectorAll<HTMLElement>(".search-hit");
        const idx = active >= 0 ? active : 0;
        (items[idx] as HTMLAnchorElement | undefined)?.click();
      }
    } else if (e.key === "/" && !typing) {
      e.preventDefault();
      open();
    }
  });
</script>
